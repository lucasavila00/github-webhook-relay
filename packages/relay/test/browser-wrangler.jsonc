{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "github-webhook-relay-browser-test",
  "main": "runtime-worker.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../../webapp/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_AUD": "test-audience",
    "ACCESS_TEAM_DOMAIN": "http://127.0.0.1:18792",
    "WEBHOOK_SECRET": "test-secret"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_RELAY",
        "class_name": "EventRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRelay"]
    }
  ]
}
