{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-webhook-relay-ingress",
  "main": "src/ingress.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hooks.example.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_RELAY",
        "class_name": "EventRelay",
        "script_name": "github-webhook-relay"
      }
    ]
  }
}
