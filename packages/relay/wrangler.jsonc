{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-webhook-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../webapp/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "relay.example.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_AUD": "set-the-access-application-audience",
    "ACCESS_TEAM_DOMAIN": "https://set-your-team.cloudflareaccess.com",
    "RELAY_HOSTNAME": "relay.example.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_RELAY",
        "class_name": "EventRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRelay"]
    }
  ]
}
