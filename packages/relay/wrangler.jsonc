{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-webhook-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_RELAY",
        "class_name": "EventRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRelay"]
    }
  ]
}
